   "source": [
    "# [BRAIN] Section 2: LLM Configuration (4-bit Gemma-7B)\n",
    "import torch\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
    "\n",
    "class StrategicBrain:\n",
    "    def __init__(self, model_id=\"google/gemma-7b-it\"):\n",
    "        print(f\"[LLM] Loading Brain: {model_id}...\")\n",
    "        bnb_config = BitsAndBytesConfig(\n",
    "            load_in_4bit=True,\n",
    "            bnb_4bit_use_double_quant=True,\n",
    "            bnb_4bit_quant_type=\"nf4\",\n",
    "            bnb_4bit_compute_dtype=torch.bfloat16\n",
    "        )\n",
    "        self.tokenizer = AutoTokenizer.from_pretrained(model_id)\n",
    "        self.model = AutoModelForCausalLM.from_pretrained(\n",
    "            model_id,\n",
    "            quantization_config=bnb_config,\n",
    "            device_map=\"auto\"\n",
    "        )\n",
    "        \n",
    "    def audit_signal(self, ticker, context_data):\n",
    "        prompt = f\"\"\"Role: Senior Institutional Quantitative Strategist\n",
    "Stock: {ticker}\n",
    "Market Context (Last 14 Days):\n",
    "{context_data}\n",
    "\n",
    "Task: \n",
    "Perform a critical audit of a 'BUY' signal generated by technical indicators. \n",
    "Look for: momentum traps, exhaustion, or genuine breakouts.\n",
    "\n",
    "Output must be JSON only:\n",
    "{{\n",
    "  \"decision\": \"PROCEED\" or \"VETO\",\n",
    "  \"conviction_score\": 0-100,\n",
    "  \"strategic_reasoning\": \"1 sentence logic\"\n",
    "}}\"\"\"\n",
    "        inputs = self.tokenizer(prompt, return_tensors=\"pt\").to(\"cuda\")\n",
    "        outputs = self.model.generate(**inputs, max_new_tokens=150, temperature=0.2)\n",
    "        response = self.tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
    "        # Simple cleaner for LLM response to get JSON\n",
    "        try: \n",
    "            json_str = response.split('{')[-1].split('}')[0]\n",
    "            return json.loads('{' + json_str + '}')\n",
    "        except: return {\"decision\": \"VETO\", \"conviction_score\": 0, \"strategic_reasoning\": \"Logic error in audit.\"}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# [INFRA] Section 3: Firebase & Data Feed\n",
    "import json, os, firebase_admin, yfinance as yf, pandas as pd\n",
    "from firebase_admin import credentials, firestore\n",
    "from datetime import datetime\n",
    "\n",
    "class FirebaseHandler:\n",
    "    def __init__(self):\n",
    "        if not firebase_admin._apps:\n",
    "            # Assume secrets are loaded in environment for Kaggle\n",
    "            from kaggle_secrets import UserSecretsClient\n",
    "            raw = UserSecretsClient().get_secret(\"FIREBASE_KEY_JSON\")\n",
    "            cred = credentials.Certificate(json.loads(raw))\n",
    "            firebase_admin.initialize_app(cred)\n",
    "        self.db = firestore.client()\n",
    "\n",
    "    def get_pending_signals(self):\n",
    "        docs = self.db.collection(\"glu_stock_queue_signals\").get()\n",
    "        return [(doc.id, doc.to_dict().get('payload')) for doc in docs]\n",
    "    \n",
    "    def final_approve(self, ticker, audit_result):\n",
    "        # Push to finalized signals queue for Executor\n",
    "        self.db.collection(\"glu_stock_final_signals\").add({\n",
    "            'ticker': ticker, \n",
    "            'audit': audit_result, \n",
    "            'timestamp': datetime.now().isoformat()\n",
    "        })\n",
    "        print(f\"[HIERARCHY] {ticker} FINALIZED by LLM.\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_strategic_audit():\n",
    "    fb = FirebaseHandler()\n",
    "    pending = fb.get_pending_signals()\n",
    "    if not pending: \n",
    "        print(\"[IDLE] No pending signals for LLM audit.\")\n",
    "        return\n",
    "    \n",
    "    brain = StrategicBrain()\n",
    "    \n",
    "    for doc_id, payload in pending:\n",
    "        # payload is a dict of {ticker: data}\n",
    "        for ticker, info in payload.items():\n",
    "            print(f\"[AUDIT] Assessing {ticker}...\")\n",
    "            df = yf.download(ticker, period='30d', interval='1d', progress=False)\n",
    "            context = df.tail(14).to_string()\n",
    "            \n",
    "            result = brain.audit_signal(ticker, context)\n",
    "            \n",
    "            # HIGHER HIERARCHY LOGIC: LLM as the Supreme Court\n",
    "            if result.get('decision') == 'PROCEED':\n",
    "                fb.final_approve(ticker, result)\n",
    "            else:\n",
    "                print(f\"[VETO] {ticker} Rejected by Strategic Brain: {result.get('strategic_reasoning')}\")\n",
    "\n",
    "    # Clear the intermediate queue\n",
    "    for doc_id, _ in pending:\n",
    "        fb.db.collection(\"glu_stock_queue_signals\").document(doc_id).delete()\n",
    "\n",
    "run_strategic_audit()"
   ]
  }
