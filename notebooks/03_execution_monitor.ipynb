    "# ️ Glu-Stock: 03_EXECUTION_MONITOR\n",
    "**Phase**: Command & Control | v18.26.6 (Self-Sequencing Sentinel)\n",
    "\n",
    "This notebook waits for 02 to complete and then pauses until exactly **08:30 WIB** to send the Legendary Report."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q requests firebase-admin yfinance pandas ta"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests, json, os, firebase_admin, yfinance as yf, pandas as pd, time\n",
    "from firebase_admin import credentials, firestore\n",
    "from datetime import datetime, timedelta, timezone\n",
    "from kaggle_secrets import UserSecretsClient\n",
    "\n",
    "def send_telegram(msg):\n",
    "    secrets = UserSecretsClient()\n",
    "    token = secrets.get_secret(\"TELEGRAM_TOKEN\")\n",
    "    chat_id = secrets.get_secret(\"TELEGRAM_CHAT_ID\")\n",
    "    url = f\"https://api.telegram.org/bot{token}/sendMessage\"\n",
    "    requests.post(url, json={\"chat_id\": chat_id, \"text\": msg, \"parse_mode\": \"Markdown\"})\n",
    "\n",
    "def wait_until_0830_wib():\n",
    "    while True:\n",
    "        # Current time in WIB (GMT+7)\n",
    "        now_wib = datetime.now(timezone.utc) + timedelta(hours=7)\n",
    "        target_wib = now_wib.replace(hour=8, minute=30, second=0, microsecond=0)\n",
    "        \n",
    "        if now_wib >= target_wib:\n",
    "            print(f\"Target time reached: {now_wib.strftime('%H:%M:%S')} WIB.\", flush=True)\n",
    "            return\n",
    "        \n",
    "        wait_seconds = (target_wib - now_wib).total_seconds()\n",
    "        print(f\"Waiting for 08:30 WIB... ({wait_seconds/3600:.2f} hours left)\", flush=True)\n",
    "        # Sleep in 15-min intervals to avoid timeouts if possible\n",
    "        time.sleep(min(600, wait_seconds))\n",
    "\n",
    "def generate_legendary_report(db):\n",
    "    ihsg = yf.download('^JKSE', period='5d', progress=False)\n",
    "    report = f\"🏆 *GLU-STOCK LEGENDARY RECAP*\\n📅 {datetime.now().strftime('%d %b %Y | 08:30 WIB')}\\nIHSG: {ihsg['Close'].iloc[-1]:,.2f} | {('📈 BULL' if ihsg['Close'].iloc[-1] > ihsg['Close'].tail(200).mean() else '📉 BEAR')}\\n\\n\"\n",
    "    \n",
    "    finals = list(db.collection(\"glu_stock_final_signals\").get())\n",
    "    report += f\"🧠 *STRATEGIC BRAIN AUDIT*\\n\"\n",
    "    if not finals: report += \"- No high-conviction signals.\\n\"\n",
    "    else:\n",
    "        for doc in finals:\n",
    "            d = doc.to_dict()\n",
    "            report += f\"✅ *{d.get('ticker')}*: {d.get('audit', {}).get('reason', 'N/A')}\\n\"\n",
    "            doc.reference.delete()\n",
    "    \n",
    "    report += \"\\n📊 *SENTINEL MODE: ACTIVE*\"\n",
    "    send_telegram(report)\n",
    "\n",
    "def run_execution_monitor():\n",
    "    secrets = UserSecretsClient()\n",
    "    cred_json = json.loads(secrets.get_secret(\"FIREBASE_KEY_JSON\"))\n",
    "    if not firebase_admin._apps: firebase_admin.initialize_app(credentials.Certificate(cred_json))\n",
    "    db = firestore.client()\n",
    "    \n",
    "    # 1. Wait for 02 to finish\n",
    "    print(\"Waiting for Strategic Brain (02)...\", flush=True)\n",
    "    wait_start = time.time()\n",
    "    while time.time() - wait_start < 3600: # Wait up to 1 hour\n",
    "        state = db.collection(\"glu_stock_state\").document(\"last_run\").get()\n",
    "        if state.exists and state.to_dict().get(\"stage\") == \"02\": break\n",
    "        time.sleep(60)\n",
    "        \n",
    "    # 2. Wait until 08:30 WIB\n",
    "    wait_until_0830_wib()\n",
    "    \n",
    "    # 3. Execution & Report\n",
    "    generate_legendary_report(db)\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    run_execution_monitor()"
   ]
  }
 ],
