   "source": [
    "# \ufe0f Glu-Stock: 04_BACKTEST_LAB\n",
    "**Phase**: Historical Performance Analysis | v18.25 (Institutional Sync)\n",
    "\n",
    "This notebook simulates signals and emulates trade exits to estimate Profit/Loss and Holding Periods for the 2025 trading year.\n",
    "**v18.25 Update**: Synchronized with Production Hub (SMA 50 + Weighted Ensemble + Expectancy Stats)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#!pip install -q yfinance pandas scikit-learn joblib tensorflow ta lightgbm\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, json, joblib, numpy as np, pandas as pd, yfinance as yf, warnings, ta\n",
    "try: import tensorflow.lite as tflite\n",
    "except: import tflite_runtime.interpreter as tflite\n",
    "from datetime import datetime, timedelta\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "def find_model_file(filename):\n",
    "    search_paths = ['/kaggle/input', '/kaggle/working', '.', 'data/models']\n",
    "    for root_dir in search_paths:\n",
    "        if not os.path.exists(root_dir): continue\n",
    "        for root, dirs, files in os.walk(root_dir):\n",
    "            if filename in files: return os.path.join(root, filename)\n",
    "    return None\n",
    "\n",
    "def frac_diff(series, d=0.4, window=100):\n",
    "    w = [1.0]\n",
    "    for k in range(1, window): w.append(-w[-1] * (d - k + 1) / k)\n",
    "    w = np.array(w[::-1])\n",
    "    res = np.full(len(series), np.nan)\n",
    "    for t in range(window - 1, len(series)): res[t] = np.dot(w, series[t - window + 1:t + 1])\n",
    "    return res\n",
    "\n",
    "class MLPredictor:\n",
    "    def __init__(self, path):\n",
    "        brain = joblib.load(path)\n",
    "        self.model = brain.get('model')\n",
    "        self.features = brain.get('features', [])\n",
    "    def build_features(self, df):\n",
    "        close, high, low, vol = df['Close'].squeeze(), df['High'].squeeze(), df['Low'].squeeze(), df['Volume'].squeeze()\n",
    "        f = pd.DataFrame(index=df.index)\n",
    "        f['Returns'] = close.pct_change()\n",
    "        f['RSI'] = ta.momentum.RSIIndicator(close=close).rsi()\n",
    "        f['MACD'] = ta.trend.MACD(close=close).macd_diff()\n",
    "        f['ATR'] = ta.volatility.AverageTrueRange(high=high, low=low, close=close).average_true_range()\n",
    "        f['ADX'] = ta.trend.ADXIndicator(high=high, low=low, close=close).adx()\n",
    "        obv = ta.volume.OnBalanceVolumeIndicator(close=close, volume=vol).on_balance_volume()\n",
    "        f['OBV_norm'] = (obv - obv.rolling(20).mean()) / (obv.rolling(20).std() + 1e-7)\n",
    "        f['day_of_week'] = df.index.dayofweek\n",
    "        f['week_of_month'] = (df.index.day - 1) // 7\n",
    "        f['frac_diff_close'] = frac_diff(close.values.flatten(), d=0.4, window=100)\n",
    "        f['vol_ratio'] = vol / (vol.rolling(20).mean() + 1e-7)\n",
    "        return f.dropna()\n",
    "    def predict(self, df):\n",
    "        try:\n",
    "            f = self.build_features(df)\n",
    "            if f.empty: return 0.0\n",
    "            return float(self.model.predict_proba(f[self.features].tail(1))[0][1])\n",
    "        except: return 0.0\n",
    "\n",
    "class CNNPredictor:\n",
    "    def __init__(self, path):\n",
    "        self.interpreter = tflite.Interpreter(model_path=path)\n",
    "        self.interpreter.allocate_tensors()\n",
    "    def predict(self, df):\n",
    "        try:\n",
    "            data = df[['Open', 'High', 'Low', 'Close', 'Volume']].tail(30).values\n",
    "            norm = (data - data.min(axis=0)) / (data.max(axis=0) - data.min(axis=0) + 1e-7)\n",
    "            self.interpreter.set_tensor(self.interpreter.get_input_details()[0]['index'], np.expand_dims(norm.astype(np.float32), axis=0))\n",
    "            self.interpreter.invoke()\n",
    "            out = self.interpreter.get_tensor(self.interpreter.get_output_details()[0]['index'])[0]\n",
    "            return float(out[1]) if len(out) > 1 else float(out[0])\n",
    "        except: return 0.5\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def simulate_trade_exit(future_df, entry_price, tp=0.03, sl=0.02, horizon=10):\n",
    "    if len(future_df) == 0: return 0.0, 0\n",
    "    tpp, slp = entry_price * (1 + tp), entry_price * (1 - sl)\n",
    "    for i in range(min(len(future_df), horizon)):\n",
    "        if future_df['High'].iloc[i] >= tpp: return tp * 100, i + 1\n",
    "        if future_df['Low'].iloc[i] <= slp: return -sl * 100, i + 1\n",
    "    final_ret = (future_df['Close'].iloc[min(len(future_df)-1, horizon-1)] / entry_price - 1) * 100\n",
    "    return final_ret, min(len(future_df), horizon)\n",
    "\n",
    "def run_institutional_backtest():\n",
    "    print(\"Starting 2025 Institutional Backtest (v18.25)...\\n\")\n",
    "    lgbm = MLPredictor(find_model_file('glu_brain_v1.joblib'))\n",
    "    cnn = CNNPredictor(find_model_file('cnn_daily_t2.tflite'))\n",
    "    \n",
    "    cohort = ['BBCA.JK', 'TLKM.JK', 'ASII.JK', 'ADRO.JK', 'BMRI.JK', 'BBRI.JK', 'ICBP.JK', 'PTBA.JK', 'ANTM.JK', 'UNTR.JK']\n",
    "    raw_data = yf.download(cohort + ['^JKSE'], start='2024-06-01', end='2025-12-31', progress=False, auto_adjust=True)\n",
    "    \n",
    "    valid_dates = [d for d in raw_data.index if d.year == 2025]\n",
    "    logs = []\n",
    "    \n",
    "    print(f\"Scanning {len(valid_dates)} trading days for signals...\")\n",
    "    for date in valid_dates:\n",
    "        for ticker in cohort:\n",
    "            try:\n",
    "                hist = raw_data.loc[:date, (slice(None), ticker)].dropna()\n",
    "                hist.columns = hist.columns.droplevel(1)\n",
    "                if len(hist) < 200: continue\n",
    "                \n",
    "                # SCANNER GATE (SMA 50 Sync)\n",
    "                if hist['Close'].iloc[-1] < hist['Close'].tail(50).mean(): continue\n",
    "                \n",
    "                # ENSEMBLE GATE\n",
    "                score = (lgbm.predict(hist) * 0.4) + (cnn.predict(hist) * 0.6)\n",
    "                if score >= 0.5:\n",
    "                    entry = float(hist['Close'].iloc[-1])\n",
    "                    future = raw_data.loc[date + timedelta(days=1):, (slice(None), ticker)]\n",
    "                    future.columns = future.columns.droplevel(1)\n",
    "                    pnl, days = simulate_trade_exit(future, entry)\n",
    "                    \n",
    "                    logs.append({'Date': date.strftime('%Y-%m-%d'), 'Ticker': ticker, 'Score': f\"{score:.1%}\", 'PnL%': pnl, 'Days': days})\n",
    "            except: continue\n",
    "            \n",
    "    df = pd.DataFrame(logs)\n",
    "    if df.empty: print(\"\\n[FAIL] No signals found.\"); return\n",
    "    \n",
    "    wr = (df['PnL%'] > 0).mean() * 100\n",
    "    pf = abs(df[df['PnL%'] > 0]['PnL%'].sum() / (df[df['PnL%'] < 0]['PnL%'].sum() + 1e-7))\n",
    "    exp = (wr/100 * df[df['PnL%']>0]['PnL%'].mean()) + ((1-wr/100) * df[df['PnL%']<0]['PnL%'].mean())\n",
    "    \n",
    "    print(f\"\\n[SUCCESS] Simulation Complete.\")\n",
    "    print(f\"--- INSTITUTIONAL RECAP (2025) ---\")\n",
    "    print(f\"Total Trades : {len(df)}\")\n",
    "    print(f\"Win Rate     : {wr:.1f}%\")\n",
    "    print(f\"Profit Factor: {pf:.2f}\")\n",
    "    print(f\"Expectancy   : {exp:.2f}% per trade\")\n",
    "    print(f\"Avg Holding  : {df['Days'].mean():.1f} Days\")\n",
    "    print(\"\\n--- Top 30 Results ---\")\n",
    "    print(df.head(30).to_string(index=False))\n",
    "\n",
    "run_institutional_backtest()\n"
   ]
  }
