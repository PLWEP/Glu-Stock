  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch, json, os, firebase_admin, yfinance as yf, pandas as pd\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n",
    "from firebase_admin import credentials, firestore\n",
    "from datetime import datetime\n",
    "\n",
    "class StrategicBrain:\n",
    "    def __init__(self, model_id=\"google/gemma-7b-it\"):\n",
    "        bnb_config = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_use_double_quant=True, bnb_4bit_quant_type=\"nf4\", bnb_4bit_compute_dtype=torch.bfloat16)\n",
    "        self.tokenizer = AutoTokenizer.from_pretrained(model_id)\n",
    "        self.model = AutoModelForCausalLM.from_pretrained(model_id, quantization_config=bnb_config, device_map=\"auto\")\n",
    "        \n",
    "    def audit_signal(self, ticker, context_data):\n",
    "        prompt = f\"Role: Senior Quant Strategist. Audit BUY signal for {ticker}. Context: {context_data}. Output JSON {{'decision': 'PROCEED/VETO', 'reason': '...'}}\"\n",
    "        inputs = self.tokenizer(prompt, return_tensors=\"pt\").to(\"cuda\")\n",
    "        response = self.tokenizer.decode(self.model.generate(**inputs, max_new_tokens=100)[0], skip_special_tokens=True)\n",
    "        try: return json.loads('{' + response.split('{')[-1].split('}')[0] + '}')\n",
    "        except: return {\"decision\": \"VETO\", \"reason\": \"Parser Error\"}\n",
    "\n",
    "def run_strategic_audit():\n",
    "    from kaggle_secrets import UserSecretsClient\n",
    "    secrets = UserSecretsClient()\n",
    "    cred_json = json.loads(secrets.get_secret(\"FIREBASE_KEY_JSON\"))\n",
    "    if not firebase_admin._apps: firebase_admin.initialize_app(credentials.Certificate(cred_json))\n",
    "    db = firestore.client()\n",
    "    \n",
    "    pending = db.collection(\"glu_stock_queue_signals\").get()\n",
    "    if not pending: return\n",
    "    \n",
    "    brain = StrategicBrain()\n",
    "    for doc in pending:\n",
    "        payload = doc.to_dict().get('payload', {})\n",
    "        for ticker, info in payload.items():\n",
    "            df = yf.download(ticker, period='30d', progress=False)\n",
    "            result = brain.audit_signal(ticker, df.tail(10).to_string())\n",
    "            if result.get('decision') == 'PROCEED':\n",
    "                db.collection(\"glu_stock_final_signals\").add({'ticker': ticker, 'audit': result, 'timestamp': datetime.now().isoformat()})\n",
    "                print(f\"[FINALIZED] {ticker} Approved.\")\n",
    "            doc.reference.delete()\n",
    "\n",
    "run_strategic_audit()"
   ]
  }
