   "source": [
    "# \ufe0f Glu-Stock: 01_INFERENCE_ENGINE\n",
    "**Phase**: Quantitative Scanning & ML Intelligence | v18.25 (Consolidated)\n",
    "\n",
    "This notebook combines the **Research Scanner** (Universe filtering) and **Signal Inference** (LGBM + CNN Ensemble) into a single streamlined stage to optimize Kaggle scheduling slots."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#!pip install -q yfinance pandas scikit-learn joblib tensorflow ta lightgbm firebase-admin\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os, json, joblib, numpy as np, pandas as pd, yfinance as yf, warnings, ta, firebase_admin\n",
    "try: import tensorflow.lite as tflite\n",
    "except: import tflite_runtime.interpreter as tflite\n",
    "from firebase_admin import credentials, firestore\n",
    "from datetime import datetime, timedelta\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "def frac_diff(series, d=0.4, window=100):\n",
    "    w = [1.0]\n",
    "    for k in range(1, window): w.append(-w[-1] * (d - k + 1) / k)\n",
    "    w = np.array(w[::-1])\n",
    "    result = np.full(len(series), np.nan)\n",
    "    for t in range(window - 1, len(series)): result[t] = np.dot(w, series[t - window + 1:t + 1])\n",
    "    return result\n",
    "\n",
    "class MLPredictor:\n",
    "    def __init__(self, path):\n",
    "        brain = joblib.load(path)\n",
    "        self.model = brain.get('model')\n",
    "        self.features = brain.get('features', [])\n",
    "    def build_features(self, df):\n",
    "        close, high, low, vol = df['Close'].squeeze(), df['High'].squeeze(), df['Low'].squeeze(), df['Volume'].squeeze()\n",
    "        f = pd.DataFrame(index=df.index)\n",
    "        f['Returns'] = close.pct_change()\n",
    "        f['RSI'] = ta.momentum.RSIIndicator(close=close).rsi()\n",
    "        f['MACD'] = ta.trend.MACD(close=close).macd_diff()\n",
    "        f['ATR'] = ta.volatility.AverageTrueRange(high=high, low=low, close=close).average_true_range()\n",
    "        f['ADX'] = ta.trend.ADXIndicator(high=high, low=low, close=close).adx()\n",
    "        obv = ta.volume.OnBalanceVolumeIndicator(close=close, volume=vol).on_balance_volume()\n",
    "        f['OBV_norm'] = (obv - obv.rolling(20).mean()) / (obv.rolling(20).std() + 1e-7)\n",
    "        f['day_of_week'] = df.index.dayofweek\n",
    "        f['week_of_month'] = (df.index.day - 1) // 7\n",
    "        f['frac_diff_close'] = frac_diff(close.values.flatten(), d=0.4, window=100)\n",
    "        f['vol_ratio'] = vol / (vol.rolling(20).mean() + 1e-7)\n",
    "        return f.dropna()\n",
    "    def predict(self, df):\n",
    "        try:\n",
    "            f = self.build_features(df)\n",
    "            if f.empty: return 0.0\n",
    "            return float(self.model.predict_proba(f[self.features].tail(1))[0][1])\n",
    "        except: return 0.0\n",
    "\n",
    "class CNNPredictor:\n",
    "    def __init__(self, path):\n",
    "        self.interpreter = tflite.Interpreter(model_path=path)\n",
    "        self.interpreter.allocate_tensors()\n",
    "    def predict(self, df):\n",
    "        try:\n",
    "            data = df[['Open', 'High', 'Low', 'Close', 'Volume']].tail(30).values\n",
    "            norm = (data - data.min(axis=0)) / (data.max(axis=0) - data.min(axis=0) + 1e-7)\n",
    "            self.interpreter.set_tensor(self.interpreter.get_input_details()[0]['index'], np.expand_dims(norm.astype(np.float32), axis=0))\n",
    "            self.interpreter.invoke()\n",
    "            out = self.interpreter.get_tensor(self.interpreter.get_output_details()[0]['index'])[0]\n",
    "            return float(out[1]) if len(out) > 1 else float(out[0])\n",
    "        except: return 0.5\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_inference_engine():\n",
    "    print(\"Starting 01_INFERENCE_ENGINE (v18.25)...\\n\")\n",
    "    \n",
    "    # 1. Models & Firebase Loading\n",
    "    from kaggle_secrets import UserSecretsClient\n",
    "    secrets = UserSecretsClient()\n",
    "    cred_json = json.loads(secrets.get_secret(\"FIREBASE_KEY_JSON\"))\n",
    "    if not firebase_admin._apps: firebase_admin.initialize_app(credentials.Certificate(cred_json))\n",
    "    db = firestore.client()\n",
    "    \n",
    "    lgbm = MLPredictor('glu_brain_v1.joblib')\n",
    "    cnn = CNNPredictor('cnn_daily_t2.tflite')\n",
    "    \n",
    "    # 2. Scanner Phase (Universe Filtering)\n",
    "    cohort = ['BBCA.JK', 'TLKM.JK', 'ASII.JK', 'ADRO.JK', 'BMRI.JK', 'BBRI.JK', 'ICBP.JK', 'PTBA.JK', 'ANTM.JK', 'UNTR.JK']\n",
    "    data = yf.download(cohort + ['^JKSE'], period='2y', progress=False, auto_adjust=True)\n",
    "    \n",
    "    candidates = []\n",
    "    for ticker in cohort:\n",
    "        try:\n",
    "            hist = data.loc[:, (slice(None), ticker)].dropna()\n",
    "            hist.columns = hist.columns.droplevel(1)\n",
    "            if len(hist) < 200: continue\n",
    "            \n",
    "            # Liquidity & Trend Gate (SMA 50)\n",
    "            vol_ok = hist['Volume'].tail(5).mean() > 100000\n",
    "            trend_ok = hist['Close'].iloc[-1] > hist['Close'].tail(50).mean()\n",
    "            \n",
    "            if vol_ok and trend_ok:\n",
    "                # 3. Inference Phase (LGBM + CNN)\n",
    "                lp = lgbm.predict(hist)\n",
    "                cp = cnn.predict(hist)\n",
    "                score = (lp * 0.4) + (cp * 0.6)\n",
    "                \n",
    "                if score >= 0.5:\n",
    "                    candidates.append({ticker: {'price': float(hist['Close'].iloc[-1]), 'score': score}})\n",
    "                    print(f\"[SIGNAL] {ticker} @ {score:.2%}\")\n",
    "        except: continue\n",
    "    \n",
    "    # 4. Push Preliminary Signals to Queue\n",
    "    if candidates:\n",
    "        for cand in candidates:\n",
    "            db.collection(\"glu_stock_queue_signals\").add({\"payload\": cand, \"timestamp\": datetime.now().isoformat()})\n",
    "        print(f\"[SUCCESS] {len(candidates)} Preliminary signals pushed to LLM queue.\")\n",
    "    else:\n",
    "        print(\"[IDLE] No new signals detected today.\")\n",
    "    \n",
    "    db.collection(\"glu_stock_history\").add({\"phase\": \"INFERENCE_HEALTH\", \"timestamp\": datetime.now().isoformat(), \"details\": {\"candidates\": len(candidates)}})\n",
    "\n",
    "run_inference_engine()\n"
   ]
  }
